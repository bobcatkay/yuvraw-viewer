YUVRAW_UI_TEXT(HdrDisplayInfo, u8"%s  峰值 %.0f nit  SDR 白 %.0f nit", u8"%s  Peak %.0f nit  SDR white %.0f nit")
YUVRAW_UI_TEXT(HdrLuminanceHelp, u8"PQ/HLG 不按参考白折算；曝光与峰值限幅仍生效", u8"PQ/HLG use absolute luminance; exposure and peak limiting still apply")
